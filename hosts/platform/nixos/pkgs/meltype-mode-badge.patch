diff -ruN a/linux/fcitx5/meltype.cpp b/linux/fcitx5/meltype.cpp
--- a/linux/fcitx5/meltype.cpp	2026-10-10 20:14:10.297856037 +0900
+++ b/linux/fcitx5/meltype.cpp	2026-10-10 20:16:46.587373821 +0900
@@ -376,6 +376,14 @@
             apply(ic, native_.take(native_.commit(state->session())));
             state->direct = toDirect;
             native_.setDirect(state->session(), toDirect ? 1 : 0);
+            // Mozc shows the mode it switched to at the cursor, through the input
+            // panel's aux slot. Meltype has the same panel, so use it too.
+            // あ spelled in bytes: a non-ASCII literal does not survive this
+            // build, and the badge is the whole point of the patch.
+            const char kana[] = { static_cast<char>(0xe3), static_cast<char>(0x81),
+                                  static_cast<char>(0x82), '\0' };
+            ic->inputPanel().setAuxUp(fcitx::Text(toDirect ? "A" : kana));
+            ic->updateUserInterface(fcitx::UserInterfaceComponent::InputPanel);
             event.filterAndAccept();
             return;
         }
